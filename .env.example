# ==========================================
# NORUVA REVENUE ENGINE CONFIGURATION
# ==========================================

# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:[PASSWORD]@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@host:5432/postgres"

# AI Intelligence (Free Google Gemini API)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=""

# Email Dispatcher: Gmail SMTP (No DNS required!) or Resend
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-letter-app-password"
RESEND_API_KEY=""
OUTREACH_FROM_EMAIL="your-email@gmail.com"

# Slack High-Intent Lead Alerts
SLACK_WEBHOOK_URL=""

# Safety Controls
OUTREACH_KILL_SWITCH="false"
MAX_DAILY_SENDS_PER_INBOX="35"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

