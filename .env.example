# ==========================================
# NORUVA REVENUE ENGINE CONFIGURATION (v1 — real engine)
# ==========================================

# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:[PASSWORD]@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@host:5432/postgres"

# AI Intelligence (Free Google Gemini API)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=""

# ---- Lead providers (v1: at least ONE is required for discovery) ----
# Prospeo — 75 verified emails/month FREE, no card: https://prospeo.io
PROSPEO_API_KEY=""
# Apollo — free plan with credits (data can be stale, always verify): https://apollo.io
APOLLO_API_KEY=""
# Hunter — 50 credits/month FREE (finder + verifier): https://hunter.io
HUNTER_API_KEY=""

# ---- Email verification gate (required before any send) ----
# MillionVerifier — 100 free credits, then ~$1.99–$4.90 / 1,000: https://millionverifier.com
MILLIONVERIFIER_API_KEY=""

# ---- Company research (optional; falls back to reading the company website) ----
# Tavily — 1,000 credits/month FREE: https://tavily.com
TAVILY_API_KEY=""

# ---- Meeting booking ----
# Create a free Cal.com account + a 15-min event, then paste YOUR link here.
MEETING_BOOKING_URL="https://cal.com/noruva-team/15min"

# ---- Sending ----
# IMPORTANT: Do NOT send cold outreach from your main domain (noruvalabs.com)
# or your personal Gmail — one bad campaign can blacklist the domain your
# product mail depends on. Correct setup (docs/REAL_V1.md): buy 2–3 separate
# outreach domains, warm them 2–4 weeks, send via Instantly or Smartlead.
# Gmail SMTP below is for LOW-VOLUME testing on a separate outreach inbox only.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-letter-app-password"
# Resend is for opted-in / transactional mail ONLY — its policy prohibits
# cold outreach. Do not use it for cold sequences.
RESEND_API_KEY=""
OUTREACH_FROM_EMAIL="your-email@gmail.com"

# CAN-SPAM requires a real physical postal address in every commercial email.
COMPANY_PHYSICAL_ADDRESS=""

# Slack High-Intent Lead Alerts
SLACK_WEBHOOK_URL=""

# Safety Controls
OUTREACH_KILL_SWITCH="false"
MAX_DAILY_SENDS_PER_INBOX="30"
# Autopilot NEVER auto-sends unless this is explicitly "true" AND the
# email is verified VALID AND the score passes the threshold.
AUTOPILOT_ALLOW_AUTO_SEND="false"
CRON_SECRET=""

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- AI Call Agent (develop2, TEST ONLY) ---
# Retell account keys: retellai.com dashboard. Real calls also need
# CALL_AGENT_ENABLED=true — without it, "Call now" only writes a
# simulated test record and never dials. See docs/CALL_AGENT.md.
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=
CALL_AGENT_ENABLED=false

# --- Lead finder: also bring phone numbers (develop2) ---
# When true, Prospeo discovery also reveals each lead's mobile for the
# AI Call Agent. COST: a mobile reveal is 10 credits (email is 1), so a
# lead with a phone costs ~11 credits. Numbers published on company
# websites are always collected free by the Web Hunter.
PROSPEO_REVEAL_MOBILE=false
