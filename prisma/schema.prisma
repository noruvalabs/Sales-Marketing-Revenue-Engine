datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum NoruvaPillar {
  INTERVIEW_COPILOT
  CLIENT_MEETINGS
  CUSTOMER_SUPPORT
  BILINGUAL_AI
}

enum CompanyStatus {
  DISCOVERED
  QUALIFIED
  DISQUALIFIED
  IN_OUTREACH
  CONVERTED
}

enum ContactStatus {
  NEW
  QUALIFIED
  DRAFT_PENDING_APPROVAL
  OUTREACH_ACTIVE
  REPLIED_INTERESTED
  REPLIED_OBJECTION
  OPTED_OUT
}

enum DraftStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  FAILED
}

enum Sentiment {
  INTERESTED
  OBJECTION
  NOT_NOW
  UNSUBSCRIBE
  NEUTRAL
}

enum CallStatus {
  QUEUED
  CALLING
  COMPLETED
  NO_ANSWER
  FAILED
  SKIPPED
}

enum DealStage {
  QUALIFIED_LEAD
  CONTACTED
  MEETING_BOOKED
  DEMO_COMPLETED
  TRIAL_ACTIVE
  PROPOSAL_SENT
  WON_PAID
  LOST
}

model Company {
  id                 String          @id @default(uuid())
  name               String
  domain             String          @unique
  website            String?
  industry           String?
  size               String?         // e.g. "10-50", "50-200"
  country            String?         @default("Global")
  techStack          String[]
  hiringSignals      String?         // e.g. "Hiring 5 remote sales reps"
  source             String          @default("MANUAL") // PROSPEO | APOLLO | HUNTER | CSV | MANUAL — a lead must have a real source
  researchSummary    String?         @db.Text
  researchEvidenceUrl String?        // source URL behind any personalised claim about this company
  
  // Intelligence & ICP Qualification
  icpScore           Int             @default(0)
  icpScoreReason     String?         @db.Text
  recommendedPillar  NoruvaPillar    @default(CLIENT_MEETINGS)
  status             CompanyStatus   @default(DISCOVERED)
  
  // Relations
  contacts           Contact[]
  deals              Deal[]
  scoreLogs          LeadScoreLog[]
  
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model Contact {
  id             String          @id @default(uuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  firstName      String
  lastName       String
  email          String          @unique
  title          String          // e.g. "Head of Talent", "VP Sales", "CEO"
  linkedinUrl    String?
  source         String          @default("MANUAL")
  // Verification gate: VALID | RISKY | INVALID | UNKNOWN. Only VALID may be
  // auto-sent; RISKY needs a human override for one manual send.
  emailVerification String       @default("UNKNOWN")
  emailVerifiedAt   DateTime?
  status         ContactStatus   @default(NEW)

  // AI Call Agent (develop2, test only): mobile number revealed via Prospeo
  // (10 credits per reveal) or added by hand. Null = no number known yet.
  phone          String?
  phoneSource    String?

  // Relations
  outreachDrafts OutreachDraft[]
  conversations  Conversation[]
  callLogs       CallLog[]
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model LeadScoreLog {
  id                 String       @id @default(uuid())
  companyId          String
  company            Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  score              Int
  painPointAnalysis  String       @db.Text
  fitVerdict         String       @db.Text
  modelUsed          String       @default("gemini-1.5-flash")
  createdAt          DateTime     @default(now())
}

model OutreachDraft {
  id             String       @id @default(uuid())
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  
  stepNumber     Int          @default(1)
  sendAfterDays  Int          @default(0) // sequence timing: step 1 = 0, step 2 = +3, step 3 = +7
  subject        String
  body           String       @db.Text
  evidenceUrl    String?      // research source behind the personalisation in this draft
  status         DraftStatus  @default(PENDING_APPROVAL)
  
  approvedAt     DateTime?
  approvedBy     String?
  sentAt         DateTime?
  errorMessage   String?
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Conversation {
  id             String       @id @default(uuid())
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  
  direction      String       @default("INBOUND") // INBOUND or OUTBOUND
  sentiment      Sentiment    @default(NEUTRAL)
  rawText        String       @db.Text
  
  createdAt      DateTime     @default(now())
}

// AI Call Agent (develop2, test only): one row per queued/placed call.
// A row with simulated=true is a TEST record only — no real call happened.
// Real rows get their transcript/summary filled by the Retell webhook.
model CallLog {
  id             String     @id @default(uuid())
  contactId      String
  contact        Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)

  phone          String
  status         CallStatus @default(QUEUED)
  retellCallId   String?
  simulated      Boolean    @default(false)
  durationSec    Int?
  outcome        String?    // MEETING_BOOKED | INTERESTED | NOT_INTERESTED | CALLBACK | NO_ANSWER | OTHER
  summary        String?    @db.Text
  transcript     String?    @db.Text
  recordingUrl   String?
  errorMessage   String?

  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Deal {
  id             String       @id @default(uuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  stage          DealStage    @default(QUALIFIED_LEAD)
  valueMrr       Decimal      @default(0) @db.Decimal(10, 2)
  notes          String?      @db.Text
  stripeCustomerId String?
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model SuppressionList {
  id             String       @id @default(uuid())
  email          String?      @unique
  domain         String?
  reason         String       @default("Unsubscribed")
  createdAt      DateTime     @default(now())
}

model AuditLog {
  id             String       @id @default(uuid())
  action         String
  entityType     String
  entityId       String
  details        Json?
  createdAt      DateTime     @default(now())
}

